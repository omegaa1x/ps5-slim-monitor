# Copia a .env (nunca se sube a Git). En GitHub Actions los secretos van en Settings > Secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Precio máximo TOTAL entregado (incluido). 575.00 cumple; 575.01 no.
MAX_TOTAL_PRICE_EUR=575.00

# Semana de máxima prioridad (hora local de TIMEZONE; el final es EXCLUSIVO)
TIMEZONE=Europe/Madrid
BLACK_FRIDAY_PEAK_START=2026-11-23T00:00:00
BLACK_FRIDAY_PEAK_END_EXCLUSIVE=2026-12-01T00:00:00

# Intervalos por fuente en minutos (normal / pico)
INTERVAL_CHOLLOMETRO_NORMAL_MIN=10
INTERVAL_CHOLLOMETRO_PEAK_MIN=2
INTERVAL_GAME_NORMAL_MIN=15
INTERVAL_GAME_PEAK_MIN=3
INTERVAL_MEDIAMARKT_NORMAL_MIN=15
INTERVAL_MEDIAMARKT_PEAK_MIN=3

ENABLED_SOURCES=game,elcorteingles,hipercor,mediamarkt,chollometro,blogdechollos,ofertitas
SEND_UNVERIFIED_ALERTS=true
ALLOW_MARKETPLACE_SELLERS=false
ALERT_PREORDERS=false
PRICE_DROP_STEP_EUR=5.00
MAX_INDIVIDUAL_ALERTS_PER_RUN=5
HEARTBEAT_LOCAL_TIME=09:00
# Gastos de envío confirmados por tienda (p. ej. 0.00); vacío = "no confirmado" si la ficha no lo indica
SHIPPING_EUR_GAME=
SHIPPING_EUR_ELCORTEINGLES=
SHIPPING_EUR_HIPERCOR=
DB_PATH=data/monitor.db
